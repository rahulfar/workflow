<!-- Custom JavaScript for Live Team Status -->
<script>
let currentLiveEmployees = [];
let currentSelectedFilter = 'all';

document.addEventListener('DOMContentLoaded', () => {
    fetchLiveTeamData();
    setInterval(fetchLiveTeamData, 8000); // 8s dynamic polling
    setInterval(tickCardTimers, 1000); // 1s live duration counter tick

    const urlParams = new URLSearchParams(window.location.search);
    const callId = urlParams.get('call_id');
    const callName = urlParams.get('call_name');
    if (callId) {
        setTimeout(() => {
            callEmployeeDirect(callId, decodeURIComponent(callName || 'Employee'));
        }, 400);
    }
});

function fetchLiveTeamData() {
    const spinIcon = document.getElementById('refreshSpinIcon');
    if (spinIcon) spinIcon.style.display = 'inline-block';

    fetch(`${BASE_URL}/api/work_summary?action=live_team`)
        .then(res => res.json())
        .then(res => {
            if (spinIcon) spinIcon.style.display = 'none';
            if (res.success && res.data) {
                currentLiveEmployees = res.data.employees || [];
                updateSummaryCounters(res.data.counts);
                filterEmployeeCards();
            }
        })
        .catch(err => {
            if (spinIcon) spinIcon.style.display = 'none';
            console.error("Live team fetch error:", err);
        });
}

function updateSummaryCounters(c) {
    if (!c) return;
    document.getElementById('sumTotalEmployees').textContent = c.total || 0;
    document.getElementById('sumWorkingEmployees').textContent = c.working || 0;
    document.getElementById('sumMeetingEmployees').textContent = c.meeting || 0;
    document.getElementById('sumLunchEmployees').textContent = c.lunch || 0;
    document.getElementById('sumWaitingEmployees').textContent = c.waiting || 0;
    document.getElementById('sumBlockedEmployees').textContent = c.blocked || 0;
    document.getElementById('sumOfflineEmployees').textContent = c.offline || 0;
}

function applyStatusFilter(status) {
    currentSelectedFilter = status;
    
    const pills = document.querySelectorAll('.filter-pill-btn');
    pills.forEach(p => {
        if (p.getAttribute('data-filter') === status) {
            p.classList.add('active');
        } else {
            p.classList.remove('active');
        }
    });

    filterEmployeeCards();
}

function filterEmployeeCards() {
    const grid = document.getElementById('employeeCardsGrid');
    if (!grid) return;

    const deptFilter = document.getElementById('filterDepartmentSelect').value;
    const projFilter = document.getElementById('filterProjectSelect').value.toLowerCase();
    const searchVal = document.getElementById('employeeSearchInput').value.toLowerCase().trim();

    const filtered = currentLiveEmployees.filter(emp => {
        // Status filter
        if (currentSelectedFilter !== 'all') {
            if (emp.status_key.toLowerCase() !== currentSelectedFilter.toLowerCase()) {
                return false;
            }
        }
        // Dept filter
        if (deptFilter !== 'all' && String(emp.department_id) !== String(deptFilter)) {
            return false;
        }
        // Project filter
        if (projFilter !== 'all' && !emp.current_project.toLowerCase().includes(projFilter)) {
            return false;
        }
        // Search query
        if (searchVal && !emp.name.toLowerCase().includes(searchVal) && !emp.designation.toLowerCase().includes(searchVal)) {
            return false;
        }
        return true;
    });

    if (filtered.length === 0) {
        grid.innerHTML = '<div class="col-12 text-center py-5 text-muted small"><i class="fas fa-users-slash fs-3 d-block mb-2 text-secondary"></i>No employees found matching the selected filters.</div>';
        return;
    }

    let html = '';
    filtered.forEach(emp => {
        const isWaiting = (emp.status_key === 'Waiting');
        const isBlocked = (emp.status_key === 'Blocked');
        const isWorking = (emp.status_key === 'Working');

        html += `
            <div class="col-12 col-md-6 col-lg-4 col-xl-3 employee-status-card-col">
                <div class="glass-card p-3.5 h-100 border rounded-3 shadow-xs hover-shadow d-flex flex-column justify-content-between position-relative">
                    <!-- Top Status Strip -->
                    <div class="d-flex justify-content-between align-items-center mb-2.5">
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="fs-6">${emp.status_emoji}</span>
                            <span class="badge ${emp.status_badge_class} rounded-pill px-2 py-0.5 fs-9 fw-bold">${escapeHtml(emp.status_display)}</span>
                        </div>
                        <span class="badge bg-light text-secondary border fs-9">${escapeHtml(emp.shift_status_text)}</span>
                    </div>

                    <!-- Profile Header -->
                    <div class="d-flex align-items-center gap-2.5 mb-2.5">
                        <img src="${emp.avatar}" alt="${escapeHtml(emp.name)}" class="rounded-circle border" width="46" height="46" style="object-fit: cover;">
                        <div class="overflow-hidden">
                            <strong class="text-dark fs-6 d-block text-truncate">${escapeHtml(emp.name)}</strong>
                            <small class="text-secondary fs-8 d-block text-truncate">${escapeHtml(emp.designation)}</small>
                            <small class="text-muted fs-9 d-block"><i class="fas fa-building me-1"></i>${escapeHtml(emp.department_name)}</small>
                        </div>
                    </div>

                    <!-- Work Details Box -->
                    <div class="p-2.5 rounded-3 bg-light border mb-2.5 fs-8">
                        <div class="mb-1 text-truncate">
                            <small class="text-muted d-block fs-9 text-uppercase">Project</small>
                            <strong class="text-dark">${escapeHtml(emp.current_project)}</strong>
                        </div>
                        <div class="mb-1 text-truncate">
                            <small class="text-muted d-block fs-9 text-uppercase">Task / Activity</small>
                            <span class="text-primary fw-semibold">${escapeHtml(emp.current_task)}</span>
                        </div>
                        
                        <div class="row g-1 mt-1 pt-1 border-top">
                            <div class="col-6">
                                <small class="text-muted fs-9 d-block">STARTED</small>
                                <span class="fw-semibold text-dark fs-8">${escapeHtml(emp.activity_start_time)}</span>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted fs-9 d-block">DURATION</small>
                                <span class="fw-bold font-monospace text-primary fs-8 live-emp-duration" data-start="${emp.activity_start_timestamp}">${escapeHtml(emp.current_duration_text)}</span>
                            </div>
                        </div>

                        ${isWaiting || isBlocked ? `
                            <div class="mt-2 p-1.5 rounded ${isBlocked ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-dark'} border small fs-9">
                                <i class="fas fa-exclamation-triangle me-1"></i><strong>${escapeHtml(emp.reason || 'Issue')}</strong>
                                ${emp.notes ? `<div class="fst-italic text-truncate mt-0.5">${escapeHtml(emp.notes)}</div>` : ''}
                            </div>
                        ` : ''}
                    </div>

                    <!-- Punctuality & Last Update Footnote -->
                    <div class="d-flex justify-content-between align-items-center fs-9 text-muted mb-3 px-1">
                        <span><i class="far fa-clock me-1"></i>Login: ${escapeHtml(emp.clock_in_time)}</span>
                        <span class="${emp.is_late ? 'text-warning fw-bold' : 'text-success'}">${escapeHtml(emp.late_text)}</span>
                    </div>

                    <!-- Action Buttons Toolbar (Section 5) -->
                    <div class="d-flex gap-1.5 pt-2 border-top">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-fill py-1 fs-8 fw-semibold" onclick="callEmployeeDirect(${emp.id}, '${escapeJs(emp.name)}')" title="Call to Meeting">
                            <i class="fas fa-video me-1"></i>Call
                        </button>
                        <a href="<?= BASE_URL ?>/chat" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-1 fs-8" title="Send Message">
                            <i class="fas fa-comment"></i>
                        </a>
                        ${emp.task_id ? `
                            <a href="<?= BASE_URL ?>/task-details?id=${emp.task_id}" class="btn btn-outline-secondary btn-sm rounded-pill px-2.5 py-1 fs-8" title="View Task">
                                <i class="fas fa-tasks"></i>
                            </a>
                        ` : ''}
                        <a href="<?= BASE_URL ?>/employee-timeline?id=${emp.id}" class="btn btn-light border btn-sm rounded-pill px-2.5 py-1 fs-8 fw-semibold text-dark" title="View Full Timeline">
                            <i class="fas fa-stream text-primary"></i>
                        </a>
                    </div>
                </div>
            </div>
        `;
    });

    grid.innerHTML = html;
}

// 1-second live duration clock tick on all active cards
function tickCardTimers() {
    const now = Math.floor(Date.now() / 1000);
    const durationEls = document.querySelectorAll('.live-emp-duration');
    durationEls.forEach(el => {
        const startTs = parseInt(el.getAttribute('data-start') || '0', 10);
        if (startTs > 0) {
            const elapsed = Math.max(0, now - startTs);
            el.textContent = formatSecondsToHMS(elapsed);
        }
    });
}

// Call to Meeting Modal Handling
function openCallMeetingModal() {
    const modal = new bootstrap.Modal(document.getElementById('callMeetingModal'));
    modal.show();
}

function callEmployeeDirect(empId, empName) {
    document.getElementById('meetingEmployeeSelect').value = empId;
    document.getElementById('meetingTitleInput').value = `${empName} Discussion`;
    openCallMeetingModal();
}

function submitCallMeeting(e) {
    e.preventDefault();
    const form = document.getElementById('callMeetingForm');
    const formData = new FormData(form);

    const btn = document.getElementById('submitMeetingCallBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sending...';

    fetch(`${BASE_URL}/api/meetings?action=call_meeting`, {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(res => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i>Send Meeting Invitation';

        if (res.success) {
            bootstrap.Modal.getInstance(document.getElementById('callMeetingModal'))?.hide();
            form.reset();
            Swal.fire('Invitation Sent!', res.message, 'success');
            fetchLiveTeamData();
        } else {
            Swal.fire('Notice', res.message, 'warning');
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i>Send Meeting Invitation';
        Swal.fire('Error', 'Failed to call meeting: ' + err.message, 'error');
    });
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
}

function escapeJs(str) {
    if (!str) return '';
    return String(str).replace(/'/g, "\\'");
}
</script>
